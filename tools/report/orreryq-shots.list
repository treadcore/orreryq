# docs/orreryq-lab-report.md's pictures: every chapter and page of the window, the six Heat panels and the
# eight Generations tabs, from the live queue, in the window's own order. Run by double-shots.sh:
#   SHOTS=tools/report/orreryq-shots.list OUT=docs/orreryq/live SIZE=1600x1000 sh tools/report/double-shots.sh QUEUE
# CHAIN=wNNNN puts one trial's chain on the Timeline (ORRERY_FRAME_CHAIN); LINEUP=trials and LINEUP_END=won (every end, going, won, dead ends) filter the
# Lineup. The live pipeline.json holds six hours: an older chain wants a state of its own (docs/orreryq/pipeline-w21532.json). JDOC: a saved treadcore-view.py document, as in hearth-shots.list.
J=${JDOC:-$J}
# 0 every page
shot 0-about queue $J ORRERY_FRAME_PAGE=0 ORRERY_FRAME_ABOUT=1
shot 0-inspector pipeline $P ORRERY_FRAME_PAGE=0 ORRERY_FRAME_HOVER=300,190
# 1 Machines
shot 1-machines machines $T/machines.json
shot 1-media media ""
shot 1-storage storage $T/storage.json
shot 1-bench bench $T/bench.json
shot 1-firmware firmware $T/machines.json
shot 1-heat-machines queue $J ORRERY_FRAME_PAGE=20 ORRERY_HEAT=0 ORRERY_HEARTH=$Q
shot 1-heat-parts queue $J ORRERY_FRAME_PAGE=20 ORRERY_HEAT=1 ORRERY_HEARTH=$Q
shot 1-heat-watts queue $J ORRERY_FRAME_PAGE=20 ORRERY_HEAT=2 ORRERY_HEARTH=$Q
shot 1-heat-steps queue $J ORRERY_FRAME_PAGE=20 ORRERY_HEAT=3 ORRERY_HEARTH=$Q
shot 1-heat-hearth queue $J ORRERY_FRAME_PAGE=20 ORRERY_HEAT=hearth ORRERY_HEARTH=$Q
shot 1-heat-diagram queue $J ORRERY_FRAME_PAGE=20 ORRERY_HEAT=diagram ORRERY_HEARTH=$Q
# 2 Projects
shot 2-projects projects $J
# 3 Queue: Fleet and Runs, then the Pipeline's eight
shot 3-fleet queue $J ORRERY_FRAME_PAGE=0 ORRERY_HEARTH=$Q
shot 3-runs queue $J ORRERY_FRAME_PAGE=1
shot 3-board pipeline $P ORRERY_FRAME_PAGE=0
shot 3-flow pipeline $P ORRERY_FRAME_PAGE=1
shot 3-timeline pipeline $P ORRERY_FRAME_PAGE=2
shot 3-timeline-day pipeline $P ORRERY_FRAME_PAGE=2 ORRERY_FRAME_ZOOM=day
shot 3-timeline-weeks pipeline $P ORRERY_FRAME_PAGE=2 ORRERY_FRAME_ZOOM=weeks
shot 3-queued pipeline $P ORRERY_FRAME_PAGE=3
shot 3-values pipeline $P ORRERY_FRAME_PAGE=4
shot 3-blame pipeline $P ORRERY_FRAME_PAGE=5
shot 3-lineup pipeline $P ORRERY_FRAME_PAGE=6
shot 3-parade pipeline $P ORRERY_FRAME_PAGE=7
[ -n "${CHAIN:-}" ] && shot 3-timeline-chain pipeline $P ORRERY_FRAME_PAGE=2 ORRERY_FRAME_CHAIN=$CHAIN
[ -n "${CHAIN:-}" ] && shot 3-lineup-chain pipeline $P ORRERY_FRAME_PAGE=6 ORRERY_FRAME_CHAIN=$CHAIN ${LINEUP:+ORRERY_FRAME_LINEUP=$LINEUP} ${LINEUP_END:+ORRERY_FRAME_LINEUP_END=$LINEUP_END}
# 4 Results, the rail's order
shot 4-candidates results $J ORRERY_FRAME_PAGE=5
shot 4-found results $J ORRERY_FRAME_PAGE=2
shot 4-net results $J ORRERY_FRAME_PAGE=3
shot 4-nets results $J ORRERY_FRAME_PAGE=13
shot 4-growth results $J ORRERY_FRAME_PAGE=14
for g in 0 1 2 3 4 5 6 7; do shot 4-generations-$g results $J ORRERY_FRAME_PAGE=18 ORRERY_FRAME_GTAB=$g; done
shot 4-recordings results $J ORRERY_FRAME_PAGE=15
shot 4-montage results $J ORRERY_FRAME_PAGE=16
shot 4-videos results $J ORRERY_FRAME_PAGE=17
shot 4-algorhythm results $J ORRERY_FRAME_PAGE=8 ORRERY_FRAME_TAB=0
shot 4-terrain results $J ORRERY_FRAME_PAGE=8 ORRERY_FRAME_TAB=1
shot 4-matrices results $J ORRERY_FRAME_PAGE=8 ORRERY_FRAME_TAB=3
shot 4-personas results $J ORRERY_FRAME_PAGE=10
shot 4-gauntlet results $J ORRERY_FRAME_PAGE=12
shot 4-flags results $J ORRERY_FRAME_PAGE=4
# 5 Watch
shot 5-lab lab ""
shot 5-sessions sessions ""
# 6 Fleet
shot 6-orchestrate fleet $T/fleet.json
shot 6-chat chat $T/chat.json
# 7 Settings
shot 7-keeper settings $J ORRERY_FRAME_PAGE=6
shot 7-aftercut settings $J ORRERY_FRAME_PAGE=19
shot 7-longrun settings $J ORRERY_FRAME_PAGE=9
shot 7-ranges settings $J ORRERY_FRAME_PAGE=11
shot 7-commits settings $J ORRERY_FRAME_PAGE=7
